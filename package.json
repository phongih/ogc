{
  "name": "ogc-v2",
  "private": true,
  "type": "module",
  "description": "OGC v2 — isolated development workspace (synthetic only, NON-PRODUCTION). No EduOS/IIOS-r1 source imported.",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "pnpm --filter @ogc/web dev",
    "build": "pnpm --filter @ogc/web build",
    "test": "pnpm --filter @ogc/web test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "9.11.1",
    "eslint": "9.11.1",
    "globals": "15.9.0",
    "typescript": "5.6.2",
    "typescript-eslint": "8.8.0"
  }
}
