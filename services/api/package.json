{
  "name": "@ogc/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "OGC Platform API (ADR-040): Fastify + Kysely + PostgreSQL. Synthetic data only until the gates in ADR-040 §6 open.",
  "exports": {
    ".": "./src/server.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "esbuild src/main.ts src/migrate.ts src/seed.ts --bundle --platform=node --format=esm --target=node22 --outdir=dist --out-extension:.js=.mjs --external:fastify --external:kysely --external:pg",
    "start": "node dist/main.mjs",
    "migrate": "node dist/migrate.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@ogc/contracts": "workspace:*",
    "fastify": "5.1.0",
    "kysely": "0.27.4",
    "zod": "3.23.8",
    "pg": "8.13.1"
  },
  "devDependencies": {
    "@ogc/iios-mock": "workspace:*",
    "@types/node": "22.7.4",
    "@types/pg": "8.11.10",
    "esbuild": "0.21.5",
    "typescript": "5.6.2",
    "vitest": "2.1.1"
  }
}
